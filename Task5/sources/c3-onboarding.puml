 Component(relay, "Outbox relay", "Python", "Доставка сохранённых команд", $tags="added")
}
Rel(partner_admin, api, "Через региональный LB / WAF", "HTTPS + JWT", $tags="added")
Rel(api, platform_iam, "Ключи JWT; текущие права", "JWKS; introspection", $tags="added")
Rel(api, tenant_catalog, "Заявка / независимые согласования", "SQL", $tags="added")
