Person(partner_admin, "Заявитель / оператор", "Заявка, статус, согласования", $tags="added")
Container(platform_iam, "Platform IAM", "Keycloak", "Аутентификация и права", $tags="added")
ContainerDb(tenant_catalog, "Каталог и workflow", "PostgreSQL", "Заявки, шаги, версии, outbox", $tags="added")
