Rel(workflow, tenant_catalog, "Шаг / результат / ACTIVE + outbox", "SQL transaction", $tags="added")
Rel(relay, tenant_catalog, "Читает outbox", "SQL", $tags="added")
Rel(relay, control_topics, "Команды / ConfigPrepared / TenantActivated", "Kafka", $tags="added")
Rel(control_topics, workflow, "Команды шагов / ACK config_version", "Kafka", $tags="added")
Rel(workflow, adapters, "Создать или сверить ресурсы", "In-process", $tags="added")
Rel(adapters, booking_db, "БД / роль домена", "SQL admin", $tags="added")
Rel(adapters, kafka, "Топики / ACL / квоты", "Admin API", $tags="added")
Rel(adapters, iam, "Развернуть Keycloak / БД; настроить SSO / роли", "Kubernetes / Admin API", $tags="added")
Rel(workflow, verify, "Проверить до активации", "In-process", $tags="added")
Rel(verify, gateway, "Изоляция и readiness", "HTTPS probes", $tags="added")
Rel(verify, iam, "Проверка входа и ролей", "OIDC", $tags="added")
Rel(control_topics, gateway, "ConfigPrepared / TenantActivated", "Kafka", $tags="added")
