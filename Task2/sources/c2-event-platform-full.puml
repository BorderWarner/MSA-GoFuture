Rel(kafka, analytics_engine, "События всех доменов")
Rel(analytics, analytics_engine, "Контракты / запуск jobs", "API")
Rel(analytics_engine, analytics_db, "Факты и витрины", "SQL")
Rel(datalens, analytics_db, "Разрешённые views", "SQL")
Rel(manager, datalens, "Бизнес-отчёты", "HTTPS")
Rel(accountant, datalens, "Финансовые отчёты", "HTTPS")
