Rel(cdc, booking_db, "Чтение outbox WAL", "Replication")
Rel(cdc, db_main, "Legacy outbox / snapshot / migration WAL", "Replication")
Rel(cdc, kafka, "Outbox; отдельные migration topics", "Kafka")
