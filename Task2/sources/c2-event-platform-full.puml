@startuml
!include <C4/C4_Container>
LAYOUT_TOP_DOWN()
skinparam defaultFontName DejaVu Sans
skinparam LegendFontColor #333333
skinparam LegendBackgroundColor #FFFFFF
skinparam LegendBorderColor #CCCCCC
skinparam nodesep 45
skinparam ranksep 65
skinparam wrapWidth 190
AddElementTag("added", $bgColor="#FFF1F1", $fontColor="#8B1A1A", $borderColor="#C62828")
AddRelTag("added", $textColor="#A51D1D", $lineColor="#C62828")
title GoFuture — C2: событийная платформа и наблюдаемость (full)
Person(passenger, "Пассажир", "Заказ и оплата")
Person(driver, "Водитель", "Поездки и выплаты")
Person(manager, "Корпоративный менеджер", "Заказы и счета")
Person(accountant, "Бухгалтер", "Выплаты и сверка")
Person(dev_engineer, "Разработчик", "Поставка функций")
Person(sre_engineer, "SRE инженер", "Надёжность")
System_Boundary(go_future_system, "GoFuture Platform") {
 Boundary(clients, "Клиентские приложения") {
  Container(web_passenger, "Пассажирское приложение", "iOS / Android / Huawei", "Заказ и оплата")
  Container(web_driver, "Водительское приложение", "iOS / Android / Huawei", "Координаты и задания")
  Container(web_portal, "Корпоративный веб-портал", "React / Vue.js", "Корпоративные поездки")
  Container(admin_portal, "Админ-панель", "Django Admin", "Поддержка и выплаты")
 }
 Boundary(access, "Доступ и совместимость") {
  Container(gateway, "API Gateway", "HTTPS / REST", "Версия API и владелец маршрута")
  Container(iam, "IAM", "Keycloak", "OIDC, роли и tenant")
  Container(compat, "Фасад совместимости", "Python", "Старые DTO; execution_owner")
 }
 Boundary(domains, "Доменные сервисы") {
  Container(booking, "Booking", "Python / Django", "Поездка и Saga")
  Container(driver_service, "Driver", "Python / Django", "Позиции и резерв")
  Container(pricing, "Pricing", "Python / Django", "Quote и тарифы")
  Container(payments, "Payments / Payouts", "Python / Django", "Ledger и выплаты")
  Container(notification, "Notification", "Python", "Каналы и доставка")
  Container(geography, "Geography", "Python / Django", "Маршруты и кандидаты")
  Container(analytics, "Analytics", "Python", "Контракты данных и витрины")
  Container(fraud, "Fraud", "Python / Django", "Риск и расследования")
 }
 Boundary(data, "Данные владельцев") {
  ContainerDb(booking_db, "Booking DB", "PostgreSQL", "Поездки и outbox")
  ContainerDb(driver_db, "Driver DB", "PostgreSQL", "Профили, резервы, outbox")
  ContainerDb(pricing_db, "Pricing DB", "PostgreSQL", "Тарифы, quote, outbox")
  ContainerDb(payments_db, "Payments DB", "PostgreSQL", "Ledger, выплаты, outbox")
  ContainerDb(notification_db, "Notification DB", "PostgreSQL", "Каналы, попытки, outbox")
  ContainerDb(geography_db, "Geography DB", "PostgreSQL", "Зоны и outbox")
  ContainerDb(analytics_meta, "Analytics metadata", "PostgreSQL", "Контракты, lineage, outbox")
  ContainerDb(fraud_db, "Fraud DB", "PostgreSQL", "Решения, расследования, outbox")
  ContainerDb(db_cache, "In-memory кеш", "Redis", "Доменные ACL и ключи")
  ContainerDb(db_search, "Поисковый индекс", "Elasticsearch", "Владелец Geography")
 }
 Boundary(events, "События и аналитика") {
  Container(migration, "Перенос данных", "Python batch / Kafka consumer", "Применение snapshot и CDC; сверка")
  Container(cdc, "CDC", "Debezium / Kafka Connect", "Доменные outbox и миграция")
  ContainerQueue(kafka, "Доменные события", "Kafka", "Region / tenant; RF=3, ISR=2", $tags="added")
  Container(analytics_engine, "Analytics Engine", "Flink / Python", "SupplyDemand / RiskFeatures / AnalyticsIngest", $tags="added")
  ContainerDb(analytics_db, "Analytics DB", "ClickHouse", "Витрины Analytics")
  Container(datalens, "DataLens", "BI Tool", "Разрешённые отчёты")
 }
 Boundary(legacy, "Переходный контур: до завершения миграции") {
  Container(aws_lb, "Исходный AWS ALB", "AWS", "Legacy API")
  Container(app_monolith, "GoFuture Monolith", "Django / EC2", "Оставшиеся домены и когорты")
  ContainerDb(db_main, "Основная legacy БД", "PostgreSQL RDS", "До передачи владельцу")
  ContainerQueue(mq_broker, "Брокер фоновых задач", "RabbitMQ", "Старые очереди")
  Container(app_worker, "Воркеры фоновых задач", "Celery", "Дренирование старых задач")
 }
 Boundary(observability, "Наблюдаемость") {
  Container(monitoring, "Prometheus", "Metrics", "SLI и alert rules")
  Container(grafana, "Grafana", "Dashboards", "Диагностика")
  Container(loki, "Loki", "Logs", "Структурированные логи")
  Container(alert_manager, "Alertmanager", "Alerts", "Маршрутизация оповещений")
 }
 Boundary(delivery, "Поставка") {
  Container(jenkins, "Jenkins", "CI/CD Server", "Независимые pipeline")
  Container(ci_worker, "CI/CD Workers", "VM / Containers", "Тесты, сборка, rollout")
  Container(artifact_repo, "Docker Registry", "Artifact Repository", "Версионированные образы")
 }
 Boundary(event_tools, "Контракты, состояние и телеметрия") {
  Container(schema_registry, "Schema Registry", "Apicurio", "Версии схем событий", $tags="added")
  ContainerDb(checkpoints, "Raw / checkpoints", "Object Storage", "Региональное состояние Flink", $tags="added")
  Container(exporters, "Exporters", "PostgreSQL / RabbitMQ / JMX / node / kube-state", "Опрос статистики БД, Kafka и кластера", $tags="added")
Container(kafka_exporter, "Kafka Exporter", "Kafka Admin / Consumer APIs", "Lag по committed offsets consumer groups", $tags="added")
  Container(collector, "OpenTelemetry Collector", "OTLP", "Фильтрация и маршрутизация", $tags="added")
  Container(tempo, "Tempo", "Traces", "Трассы Saga", $tags="added")
 }

}
System_Ext(yandex_pay, "Яндекс Пэй", "Платёжный шлюз")
System_Ext(yandex_maps, "Яндекс Карты", "Маршруты")
System_Ext(fcm, "FCM", "Push для Android")
System_Ext(apns, "APNs", "Push для iOS")
System_Ext(huawei_push, "Huawei Push Kit", "Push для Huawei")
System_Ext(bank_api, "API Банка", "Выплаты")
Rel(passenger, web_passenger, "Заказ")
Rel(driver, web_driver, "Работа")
Rel(manager, web_portal, "Заказы")
Rel(accountant, admin_portal, "Выплаты")
Rel(web_passenger, gateway, "API", "HTTPS")
Rel(web_driver, gateway, "API и позиции", "HTTPS")
Rel(web_portal, gateway, "API", "HTTPS")
Rel(admin_portal, gateway, "API", "HTTPS")
Rel(gateway, iam, "Ключи проверки JWT", "JWKS / HTTPS")
