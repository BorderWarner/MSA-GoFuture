Rel(app_monolith, mq_broker, "Старые задачи", "AMQP")
Rel(app_worker, mq_broker, "Потребляет", "AMQP")
Rel(app_worker, db_main, "Своя когорта", "SQL")
Rel(booking, geography, "Кандидаты / маршрут", "REST")
